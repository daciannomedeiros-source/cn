{
  "name": "versiculo-ao-vivo",
  "version": "0.2.0",
  "description": "Versículos ao vivo no telão: detector, Auto/Manual e janela de saída",
  "author": "TechSolution Eventos",
  "main": "app/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.techsolution.versiculoaovivo",
    "productName": "Versiculo ao Vivo",
    "files": ["app/**/*", "src/**/*", "package.json"],
    "directories": { "output": "dist" },
    "artifactName": "VersiculoAoVivo-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
